---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogHeader from '../../components/BlogHeader.astro';
import BlogFooter from '../../components/BlogFooter.astro';
import { getPublishedPosts, formatDate, isoDate, readingTime, tagSlug, type Post } from '../../lib/blog';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, description, date, updated, author, tags, image, imageAlt } = post.data;
const minutes = readingTime(post.body);
const path = `/blog/${post.id}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: isoDate(date),
  ...(updated ? { dateModified: isoDate(updated) } : {}),
  author: { '@type': 'Person', name: author },
  publisher: { '@type': 'Organization', name: 'Accesa', url: 'https://accesa.agency/' },
  mainEntityOfPage: new URL(path, 'https://accesa.agency').href,
  inLanguage: 'es-CL',
  ...(image ? { image: new URL(image, 'https://accesa.agency').href } : {}),
};
---
<Base lang="es" title={`${title} — Accesa`} description={description} path={path} ogType="article" ogImage={image ?? undefined}>
<script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
<BlogHeader current="post" />
<main id="main-content">
  <article>
    <div class="b-hero">
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <ol>
          <li><a href="/">Inicio</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li aria-current="page">Artículo</li>
        </ol>
      </nav>
      {tags.length > 0 && (
        <ul class="tag-list" role="list" aria-label="Etiquetas">
          {tags.map((t) => <li><a class="tag-link" href={`/blog/etiqueta/${tagSlug(t)}/`}>{t}</a></li>)}
        </ul>
      )}
      <h1 class="b-title">{title}</h1>
      <p class="b-intro">{description}</p>
      <p class="post-meta">
        <span>Por <strong>{author}</strong></span>
        <span><time datetime={isoDate(date)}>{formatDate(date)}</time></span>
        <span>{minutes} {minutes === 1 ? 'minuto' : 'minutos'} de lectura</span>
      </p>
    </div>

    {image && (
      <figure class="post-figure">
        <img src={image} alt={imageAlt} loading="eager" decoding="async" />
      </figure>
    )}

    <div class="post-body">
      <div class="prose">
        <Content />
      </div>
      {updated && (
        <p class="post-updated">Actualizado el <time datetime={isoDate(updated)}>{formatDate(updated)}</time></p>
      )}
    </div>
  </article>

  <aside class="post-cta" aria-labelledby="cta-titulo">
    <h2 class="post-cta-title" id="cta-titulo">¿Tu organización necesita revisar su accesibilidad?</h2>
    <p>Conversemos sin compromiso sobre tu sitio, tu plataforma o tus documentos.</p>
    <a href="/#contacto">Conversemos</a>
  </aside>

  <p class="post-back"><a href="/blog/">← Volver al blog</a></p>
</main>
<BlogFooter />
</Base>
