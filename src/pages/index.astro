---
import Base from '../layouts/Base.astro';
import '../styles/home-es.css';
---
<Base lang="es" title="Accesa — Agencia de Accesibilidad" description="Accesa es una agencia chilena especializada en accesibilidad digital e inclusión. Auditorías WCAG 2.2, consultoría, diseño inclusivo y capacitación." path="/" alternates={{ es: '/', en: '/en/' }}>
<a href="#main-content" class="skip-link">Saltar al contenido principal</a>

<!-- Cursor -->
<div id="cursor"></div>

<!-- Enlace a declaración de accesibilidad -->
<a href="/accesibilidad/" id="a11yBtn" aria-label="Ver declaración de accesibilidad WCAG 2.2 AA de Accesa">
  <span class="a11y-dot"></span>
  <span>Declaración de Accesibilidad</span>
</a>

<header role="banner">
<!-- ═══ NAV ═══ -->
<nav id="nav" aria-label="Navegación principal">
  <a href="#" class="nav-logo" aria-label="Accesa — inicio">
    <svg class="nav-sym nav-sym-light" viewBox="0 0 60 60" aria-hidden="true" focusable="false">
      <circle cx="30" cy="30" r="26" fill="none" stroke="#C4522A" stroke-width="3"/>
      <path d="M20 42 L30 16 L40 42" fill="none" stroke="#1A1A1A" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="30" cy="13" r="4" fill="#E8A030"/>
    </svg>
    <svg class="nav-sym nav-sym-dark" viewBox="0 0 60 60" aria-hidden="true" focusable="false">
      <circle cx="30" cy="30" r="26" fill="none" stroke="#C4522A" stroke-width="3"/>
      <path d="M20 42 L30 16 L40 42" fill="none" stroke="#FAF6EE" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="30" cy="13" r="4" fill="#E8A030"/>
    </svg>
    <span class="nav-wordmark">accesa</span>
  </a>
  <ul class="nav-links" role="list">
    <li><a href="#servicios">Servicios</a></li>
    <li><a href="#nosotras">Nosotras</a></li>
    <li><a href="#proceso">Proceso</a></li>
    <li><a href="/blog/">Blog</a></li>
    <li><a href="#contacto" class="nav-cta">Conversemos</a></li>
  </ul>
  <a href="/en/" class="lang-switch" aria-label="Switch to English version" lang="en" hreflang="en">EN</a>
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<!-- MENÚ MÓVIL -->
<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menú de navegación">
  <button class="mobile-close" id="mobile-close" aria-label="Cerrar menú">&#10005;</button>
  <a href="#servicios"  id="ml-servicios">Servicios</a>
  <a href="#nosotras"   id="ml-nosotras">Nosotras</a>
  <a href="#proceso"    id="ml-proceso">Proceso</a>
