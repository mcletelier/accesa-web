</header>
<main id="main-content">
<!-- ═══ HERO ═══ -->
<section class="hero" id="inicio">
  <div class="hero-circle c1"></div>
  <div class="hero-circle c2"></div>
  <div class="hero-circle c3"></div>

  <div class="hero-left">
    <div class="hero-eyebrow">Accessibility Agency · Santiago, Chile</div>
    <h1 class="hero-title">We design<br>for <em>everyone.</em></h1>
    <p class="hero-sub">Accesa is an agency specialized in digital accessibility and inclusion. We remove barriers so no one is left out — regardless of how they see, hear, or interact with the world.</p>
    <div class="hero-actions">
      <a href="#servicios" class="btn-primary">Our services</a>
      <a href="#contacto" class="btn-outline">Let's talk</a>
      <a href="https://accesa-auditor.pages.dev/" class="btn-auditor" hreflang="es">Free site audit <span class="btn-note">(in Spanish)</span> <span aria-hidden="true">&#8599;</span></a>
    </div>
  </div>

  <div class="hero-right">
    <div style="position:relative; display:flex; align-items:center; justify-content:center;">
      <svg class="ring-svg" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
        <defs>
          <path id="ring-path" d="M100,100 m-75,0 a75,75 0 1,1 150,0 a75,75 0 1,1 -150,0"/>
        </defs>
        <circle cx="100" cy="100" r="75" fill="none" stroke="rgba(196,82,42,0.22)" stroke-width="1"/>
        <circle cx="100" cy="100" r="86" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
        <text font-family="Space Mono,monospace" font-size="7.5" fill="rgba(255,255,255,0.28)" letter-spacing="5">
          <textPath href="#ring-path">ACCESSIBILITY · INCLUSION · UNIVERSALITY · CHILE · LATAM · </textPath>
        </text>
      </svg>
      <svg class="center-sym" viewBox="0 0 60 60" aria-hidden="true" focusable="false">
        <circle cx="30" cy="30" r="26" fill="none" stroke="rgba(196,82,42,0.55)" stroke-width="2.5"/>
        <path d="M20 42 L30 16 L40 42" fill="none" stroke="#FAF6EE" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="30" cy="13" r="4" fill="#E8A030"/>
