<!-- ═══ SERVICIOS ═══ -->
<section id="servicios" aria-labelledby="titulo-servicios">
  <div class="section-wrap">
    <div class="section-eyebrow reveal">01 — Services</div>
    <div class="servicios-header">
      <h2 id="titulo-servicios" class="servicios-title reveal">What we do</h2>
      <p class="servicios-intro reveal">We offer a complete suite of accessibility services so your organization not only meets the standard — but leads inclusion in your industry.</p>
    </div>
    <div class="servicios-grid">
      <div class="servicio-card reveal">
        <div class="servicio-num">01</div>
        <svg class="servicio-icon" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
          <rect x="4" y="4" width="32" height="32" rx="2" fill="none" stroke="#C4522A" stroke-width="1.5"/>
          <path d="M10 20 L18 28 L30 12" stroke="#C4522A" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div class="servicio-title">Accessibility Audit</div>
        <p class="servicio-desc">We evaluate your website, app or digital platform against WCAG 2.2 standards. We deliver a clear report with prioritized findings and an action plan.</p>
        <div class="servicio-tags"><span class="tag">WCAG 2.2</span><span class="tag">VPAT</span><span class="tag">Informe</span></div>
      </div>
      <div class="servicio-card reveal">
        <div class="servicio-num">02</div>
        <svg class="servicio-icon" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
          <circle cx="20" cy="20" r="14" fill="none" stroke="#C4522A" stroke-width="1.5"/>
          <circle cx="20" cy="14" r="3" fill="#C4522A"/>
          <path d="M14 28 Q14 22 20 22 Q26 22 26 28" fill="none" stroke="#C4522A" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <div class="servicio-title">Strategic Consulting</div>
        <p class="servicio-desc">We guide your team in designing and implementing a sustainable accessibility strategy. From internal policy to technical roadmap.</p>
        <div class="servicio-tags"><span class="tag">Estrategia</span><span class="tag">Roadmap</span><span class="tag">Policy</span></div>
      </div>
      <div class="servicio-card reveal">
        <div class="servicio-num">03</div>
        <svg class="servicio-icon" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
          <path d="M8 32 L8 16 L20 8 L32 16 L32 32 Z" fill="none" stroke="#C4522A" stroke-width="1.5" stroke-linejoin="round"/>
          <rect x="15" y="22" width="10" height="10" fill="none" stroke="#C4522A" stroke-width="1.5"/>
        </svg>
        <div class="servicio-title">Inclusive Design</div>
        <p class="servicio-desc">We integrate accessibility from the very beginning of the design process. We review wireframes, prototypes and design systems to ensure inclusion from day one.</p>
        <div class="servicio-tags"><span class="tag">UX</span><span class="tag">Design System</span><span class="tag">Figma</span></div>
      </div>
      <div class="servicio-card reveal">
        <div class="servicio-num">04</div>
        <svg class="servicio-icon" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
          <rect x="6" y="10" width="28" height="20" rx="2" fill="none" stroke="#C4522A" stroke-width="1.5"/>
          <path d="M6 16 L34 16" stroke="#C4522A" stroke-width="1.5"/>
          <circle cx="12" cy="13" r="1.5" fill="#C4522A"/>
          <circle cx="18" cy="13" r="1.5" fill="#C4522A"/>
        </svg>
        <div class="servicio-title">Training</div>
        <p class="servicio-desc">Workshops and training for design, development and product teams. We build an accessibility culture from within so change lasts.</p>
        <div class="servicio-tags"><span class="tag">Workshops</span><span class="tag">E-learning</span><span class="tag">Equipos</span></div>
      </div>
      <div class="servicio-card reveal">
        <div class="servicio-num">05</div>
        <svg class="servicio-icon" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
          <path d="M10 30 L10 22 L16 18 L22 22 L22 30" fill="none" stroke="#C4522A" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M22 30 L22 20 L28 14 L34 20 L34 30" fill="none" stroke="#C4522A" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M6 30 L34 30" stroke="#C4522A" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <div class="servicio-title">Continuous Monitoring</div>
        <p class="servicio-desc">Accessibility is not a checkbox — it is a process. We offer periodic monitoring so your platform maintains its standards with every update.</p>
        <div class="servicio-tags"><span class="tag">Monthly report</span><span class="tag">Alertas</span><span class="tag">Dashboard</span></div>
      </div>
      <div class="servicio-card reveal">
        <div class="servicio-num">06</div>
        <svg class="servicio-icon" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
          <circle cx="20" cy="20" r="14" fill="none" stroke="#C4522A" stroke-width="1.5"/>
          <path d="M12 20 Q12 14 20 14 Q28 14 28 20 Q28 26 20 26" fill="none" stroke="#C4522A" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M16 24 L12 28" stroke="#C4522A" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <div class="servicio-title">User Testing</div>
        <p class="servicio-desc">Testing sessions with people with disabilities — real assistive technology users. Nothing replaces the perspective of those who use your product every day.</p>
        <div class="servicio-tags"><span class="tag">Real testing</span><span class="tag">Screen readers</span><span class="tag">Insights</span></div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ NUMEROS ═══ -->
<div class="numeros reveal">
