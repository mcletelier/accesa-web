      <div class="numero-label">People worldwide<br>live with a disability</div>
    </div>
    <div class="numero-item">
      <div class="numero-val">96%</div>
      <div class="numero-label">Of websites have<br>accessibility errors</div>
    </div>
    <div class="numero-item">
      <div class="numero-val">+28%</div>
      <div class="numero-label">Additional revenue in<br>inclusive companies</div>
    </div>
    <div class="numero-item">
      <div class="numero-val">10+</div>
