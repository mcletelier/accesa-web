---
import ContactForm from '../../components/ContactForm.astro';
import Base from '../../layouts/Base.astro';
import '../../styles/home-en.css';
---
<Base lang="en" title="Accesa — Accessibility Agency" description="Accesa is a Chilean agency specialized in digital accessibility and inclusion. WCAG 2.2 audits, consulting, inclusive design and training." path="/en/" alternates={{ es: '/', en: '/en/' }}>
<a href="#main-content" class="skip-link">Skip to main content</a>

<!-- Cursor -->
<div id="cursor"></div>

<!-- Enlace a declaración de accesibilidad -->
<a href="/en/accessibility/" id="a11yBtn" aria-label="View Accesa WCAG 2.2 AA accessibility statement">
  <span class="a11y-dot"></span>
  <span>Accessibility Statement</span>
</a>

<header role="banner">
<!-- ═══ NAV ═══ -->
