    <span class="ticker-item">Universal UX</span><span class="ticker-sep">·</span>
    <span class="ticker-item">WCAG 2.2</span><span class="ticker-sep">·</span>
    <span class="ticker-item">Accessibility audits</span><span class="ticker-sep">·</span>
    <span class="ticker-item">Inclusive design</span><span class="ticker-sep">·</span>
