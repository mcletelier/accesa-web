<script is:inline>
// ── TABS ──
var tabs = document.querySelectorAll('.tab-btn');
var panels = document.querySelectorAll('.audience-panel');

var sidebarLinks = {
  'panel-comunidad': [
    { href: '#com-compromiso',  label: 'Nuestro compromiso' },
    { href: '#com-tecnologias', label: 'Tecnologías compatibles' },
    { href: '#com-barreras',    label: 'Reportar una barrera' }
  ],
  'panel-clientes': [
    { href: '#org-valor',     label: 'Por qué importa' },
    { href: '#org-servicios', label: 'Cómo podemos ayudarte' }
  ],
  'panel-tecnicos': [
    { href: '#tec-conformidad',    label: 'Declaración de conformidad' },
    { href: '#tec-implementacion', label: 'Implementación técnica' },
    { href: '#tec-pruebas',        label: 'Metodología de prueba' },
    { href: '#tec-historial',      label: 'Registro de auditorías' },
    { href: '#tec-contacto',       label: 'Contacto técnico' }
  ]
};

function updateSidebar(panelId) {
  var nav = document.getElementById('sidebar-links');
  nav.innerHTML = '';
  var links = sidebarLinks[panelId] || [];
  links.forEach(function(item) {
    var li = document.createElement('li');
    var a = document.createElement('a');
    a.href = item.href;
    a.textContent = item.label;
    li.appendChild(a);
    nav.appendChild(li);
  });
}

tabs.forEach(function(tab) {
  tab.addEventListener('click', function() {
    var targetId = tab.getAttribute('aria-controls');

    tabs.forEach(function(t) {
      t.classList.remove('active');
      t.setAttribute('aria-selected', 'false');
    });
    panels.forEach(function(p) {
      p.classList.remove('active');
    });

    tab.classList.add('active');
    tab.setAttribute('aria-selected', 'true');
    var panel = document.getElementById(targetId);
    if (panel) panel.classList.add('active');

    updateSidebar(targetId);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Keyboard navigation entre tabs
  tab.addEventListener('keydown', function(e) {
    var idx = Array.from(tabs).indexOf(tab);
    if (e.key === 'ArrowRight' && idx < tabs.length - 1) {
      tabs[idx + 1].focus();
      tabs[idx + 1].click();
    }
    if (e.key === 'ArrowLeft' && idx > 0) {
      tabs[idx - 1].focus();
      tabs[idx - 1].click();
    }
  });
});

// Inicializar sidebar
updateSidebar('panel-comunidad');

// Highlight sidebar link activo al hacer scroll
window.addEventListener('scroll', function() {
  var links = document.querySelectorAll('.sidebar-nav a');
  var activePanel = document.querySelector('.audience-panel.active');
  if (!activePanel) return;

  var sections = activePanel.querySelectorAll('.content-section');
  var current = '';

  sections.forEach(function(s) {
    if (window.scrollY >= s.offsetTop - 160) {
      current = s.id;
    }
  });

  links.forEach(function(a) {
    a.classList.remove('active');
    if (a.getAttribute('href') === '#' + current) {
      a.classList.add('active');
    }
  });
});
</script>
</Base>
