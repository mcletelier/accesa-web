---
/** Encabezado de páginas secundarias: blog y avisos (mismo estilo que la Declaración de Accesibilidad) */
interface Props { current?: 'blog' | 'post'; lang?: 'es' | 'en' }
const { current, lang = 'es' } = Astro.props;
const es = lang === 'es';
const home = es ? '/' : '/en/';
---
<a href="#main-content" class="skip-link">{es ? 'Saltar al contenido principal' : 'Skip to main content'}</a>
<header>
<nav class="b-nav" aria-label={es ? 'Navegación principal' : 'Main navigation'}>
  <a href={home} class="b-nav-logo" aria-label={es ? 'Accesa — inicio' : 'Accesa — home'}>
    <svg viewBox="0 0 60 60" aria-hidden="true" focusable="false">
      <circle cx="30" cy="30" r="26" fill="none" stroke="#C4522A" stroke-width="3"/>
      <path d="M20 42 L30 16 L40 42" fill="none" stroke="#FAF6EE" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="30" cy="13" r="4" fill="#E8A030"/>
    </svg>
    <span class="b-nav-wordmark">accesa</span>
  </a>
  <ul class="b-nav-links" role="list">
    <li><a href={`${home}#servicios`}>{es ? 'Servicios' : 'Services'}</a></li>
    {es && <li><a href="/blog/" aria-current={current === 'blog' ? 'page' : undefined}>Blog</a></li>}
    <li><a href={`${home}#contacto`} class="b-nav-cta">{es ? 'Conversemos' : "Let's talk"}</a></li>
  </ul>
</nav>
</header>
